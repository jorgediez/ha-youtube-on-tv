{
  "entity": {
    "binary_sensor": {
      "ad_playing": {
        "default": "mdi:advertisements-off",
        "state": {
          "on": "mdi:advertisements"
        }
      }
    },
    "button": {
      "skip_ad": {
        "default": "mdi:skip-next"
      }
    },
    "sensor": {
      "app_state": {
        "default": "mdi:application",
        "state": {
          "running": "mdi:play-box",
          "stopped": "mdi:stop-circle-outline",
          "hidden": "mdi:application-outline",
          "unreachable": "mdi:television-off"
        }
      },
      "up_next": {
        "default": "mdi:playlist-play"
      },
      "subtitles": {
        "default": "mdi:subtitles",
        "state": {
          "off": "mdi:subtitles-outline"
        }
      }
    },
    "switch": {
      "autoplay": {
        "default": "mdi:autorenew",
        "state": {
          "off": "mdi:autorenew-off"
        }
      }
    },
    "select": {
      "playback_speed": {
        "default": "mdi:play-speed"
      }
    }
  }
}
